#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

get_id() {
    wctl list --json | jq -r \
        --arg class "$1" \
        '[.[] | select(.wm_class == $class)] | first | .id // empty'
}

launch_if_missing() {
    local class="$1"
    local app="$2"
    local id

    id=$(get_id "$class")

    if [[ -z "$id" ]]; then
        case "$app" in
            herdr) herdr-app >/dev/null 2>&1 & ;;
            files) nautilus --new-window >/dev/null 2>&1 & ;;
            chrome) google-chrome --new-window >/dev/null 2>&1 & ;;
            term) wezterm start --always-new-process --class org.wezfurlong.wezterm-terminal >/dev/null 2>&1 & ;;
        esac

        for _ in {1..30}; do
            sleep 0.5
            id=$(get_id "$class")
            [[ -n "$id" ]] && break
        done

        if [[ -z "$id" ]]; then
            echo "Could not find $class" >&2
            exit 1
        fi

        echo "CREATED"
    else
        echo "$id"
    fi
}

HERDR_RESULT=$(launch_if_missing "herdr-app" herdr)
FILES_RESULT=$(launch_if_missing "org.gnome.Nautilus" files)
CHROME_RESULT=$(launch_if_missing "google-chrome" chrome)
TERM_RESULT=$(launch_if_missing "org.wezfurlong.wezterm-terminal" term)

CREATED=false

[[ "$HERDR_RESULT" == "CREATED" || "$FILES_RESULT" == "CREATED" || "$CHROME_RESULT" == "CREATED" || "$TERM_RESULT" == "CREATED" ]] && CREATED=true

HERDR=$(get_id "herdr-app")
FILES=$(get_id "org.gnome.Nautilus")
CHROME=$(get_id "google-chrome")
TERM=$(get_id "org.wezfurlong.wezterm-terminal")

if [[ "$CREATED" == "true" ]]; then
    NEEDS_RESTORE=true
else
    NEEDS_RESTORE=$(
        wctl list --json | jq -r \
            --argjson herdr "$HERDR" \
            --argjson files "$FILES" \
            --argjson chrome "$CHROME" \
            --argjson term "$TERM" \
            '[.[] | select(
                .id == $herdr or
                .id == $files or
                .id == $chrome or
                .id == $term
            ) | (.is_minimized or .is_hidden)] | any'
    )
fi

if [[ "$NEEDS_RESTORE" == "true" ]]; then
    wctl activate "$HERDR" --no-animation
    wctl activate "$FILES" --no-animation
    wctl activate "$CHROME" --no-animation
    wctl activate "$TERM" --no-animation

    wctl place "$HERDR" left top 50% 75%
    wctl place "$FILES" left bottom 50% 25%
    wctl place "$CHROME" right top 50% 75%
    wctl place "$TERM" right bottom 50% 25%

    echo "Workspace restored"
else
    wctl minimize "$HERDR" --no-animation
    wctl minimize "$FILES" --no-animation
    wctl minimize "$CHROME" --no-animation
    wctl minimize "$TERM" --no-animation

    echo "Workspace hidden"
fi
